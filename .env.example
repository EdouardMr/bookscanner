# --- Required ---

# Anthropic API key, used for vision (reading book spines) and recommendations.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string (Neon). Provision via the Vercel Neon integration,
# or directly at https://neon.tech, then paste the pooled connection string here.
DATABASE_URL=

# --- Optional ---

# Fallback book-metadata source used when Open Library has no match.
# Get a key at https://console.cloud.google.com/apis/library/books.googleapis.com
# (Open Library requires no key and is tried first, so the app works without this.)
GOOGLE_BOOKS_API_KEY=

# Override the Claude model used for vision extraction + recommendations.
ANTHROPIC_MODEL=claude-sonnet-5
