# --- Required ---

# Anthropic API key, used for vision (reading book spines) and recommendations.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string (Neon). Provision via the Vercel Neon integration,
# `neon env pull` (see the neon/neon-postgres agent skills in .agents/skills),
# or directly at https://neon.tech — paste the pooled connection string here.
DATABASE_URL=

# Optional: Neon's direct (non-pooled) connection string. Used only by
# drizzle-kit (db:generate/db:push) for migrations, which need session-level
# operations that don't work over the pooled connection. Falls back to
# DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# --- Optional ---

# Fallback book-metadata source used when Open Library has no match, *and*
# fallback OCR (Google Cloud Vision, TEXT_DETECTION) used when Claude's
# vision call can't be reached — our own 1-call-per-minute limit, an
# Anthropic outage, etc. (see lib/google/visionFallback.ts). Get a key at
# https://console.cloud.google.com/apis/library/books.googleapis.com and
# also enable the Cloud Vision API for the same project at
# https://console.cloud.google.com/apis/library/vision.googleapis.com —
# Vision has no unauthenticated tier, so without this the scan step just
# errors instead of falling back when Claude is unavailable.
# (Open Library requires no key and is tried first for metadata, so the
# app works without this for that part.)
GOOGLE_BOOKS_API_KEY=

# Override the Claude model used for vision extraction + recommendations.
ANTHROPIC_MODEL=claude-sonnet-5
